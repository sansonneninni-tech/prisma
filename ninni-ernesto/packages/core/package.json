{
  "name": "@ne/core",
  "version": "0.3.0",
  "private": true,
  "description": "Base comune dei siti di Isabella Pistillo: catalogo, immagini, i18n, carrello, prezzi/IVA/spedizioni, checkout demo, email, form. Senza stile.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./cart": "./src/cart/index.ts",
    "./checkout": "./src/checkout/index.ts",
    "./email": "./src/email/index.ts",
    "./forms": "./src/forms/index.ts",
    "./config": "./src/config/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ar": "./src/ar/index.ts",
    "./integration": "./src/integration.ts",
    "./components/*": "./components/*"
  },
  "files": [
    "src",
    "components"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json && astro check --root playground",
    "ar:verifica": "node scripts/ar/verifica_glb.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "nanostores": "1.5.5",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "astro": "7.4.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
