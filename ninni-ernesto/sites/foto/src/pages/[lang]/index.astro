---
/**
 * Home (audit ninni 03/11): zero scorrimento, fondo bianco, le foto di Ninni e di Ernesto che si incrociano
 * (components/home/Mazzo.astro) e il nome gigante con i due negozi. Niente footer (Base `home`).
 */
import Base from '../../layouts/Base.astro';
import Mazzo from '../../components/home/Mazzo.astro';
import { localeStaticPaths, type Locale } from '@ne/core/i18n';
export const getStaticPaths = () => localeStaticPaths();
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} home>
  <Mazzo lang={lang} />
</Base>
