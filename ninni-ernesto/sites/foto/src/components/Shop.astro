---
/**
 * «Shop» nell'header, blu 004e89 (audit ninni 03/11): un bottone (borsa + parola) che apre una tendina con i due
 * negozi, Ninni ed Ernesto. Stesso comportamento del menu «What?» (lib/what-client.ts).
 * Sotto 375 px resta solo l'icona (area 44 × 44, nome accessibile dal testo nascosto).
 */
import { href, useT, type Locale } from '../lib/i18n';
interface Props { lang: Locale; pathname: string }
const { lang, pathname } = Astro.props;
const t = useT(lang);
const voci = (['ninni', 'ernesto'] as const).map((a) => ({ testo: t(`galleria.nav.${a}`), url: href(lang, `/${a}/`) }));
const qui = voci.some((v) => pathname === v.url);
---
<div class="tendina tendina--dx" data-tendina>
  <button class="hd__btn hd__shop" type="button" aria-expanded="false" aria-controls="shop-menu" data-tendina-apri aria-current={qui ? 'true' : undefined}
    ><svg class="hd__borsa" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.8 7.2h12.4l-.9 10.3H4.7z" /><path d="M7.3 7.2V5.6a2.7 2.7 0 0 1 5.4 0v1.6" /></svg><span class="hd__shop-t">{t('galleria.nav.shop')}</span></button
  >
  <nav class="what__menu shop__menu" id="shop-menu" aria-label={t('galleria.nav.shop')} data-tendina-menu hidden>
    <ul class="what__ul">
      {voci.map((v) => <li><a class="what__a" href={v.url} aria-current={pathname === v.url ? 'page' : undefined}>{v.testo}</a></li>)}
    </ul>
  </nav>
</div>
