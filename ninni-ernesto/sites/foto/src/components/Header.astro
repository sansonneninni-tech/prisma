---
/**
 * C1 Header (audit ninni 03/11): fisso, senza filetto.
 * Sinistra «What?», con le lettere del vecchio logotipo: apre un menu a tendina con Stampe · Carte e cornici · PRISMA ·
 * Chi siamo · Contatti (fuori dalla home anche Home). Al posto di logo, Shop e Indice.
 * Destra: Shop (blu 004e89, audit ninni 03/11) · Carrello (n) · IT EN.
 * In home l'header è trasparente e in differenza sopra le foto che scorrono (styles/struttura.css).
 * Comportamento del menu in lib/what-client.ts.
 */
import Lingue from './Lingue.astro';
import ContaCarrello from './ContaCarrello.astro';
import Shop from './Shop.astro';
import { href, useT, type Locale } from '../lib/i18n';
import { PRISMA } from '../lib/nav';
interface Props { lang: Locale; pathname: string; /** checkout: il menu c'è, ma niente link che tolgono il fuoco dall'ordine in più */ ridotto?: boolean }
const { lang, pathname } = Astro.props;
const t = useT(lang);
const home = pathname === `/${lang}/` || pathname === `/${lang}`;
const voci = [
  ...(home ? [] : [{ testo: t('galleria.nav.home'), url: href(lang, '/'), fuori: false }]),
  { testo: t('galleria.nav.stampe'), url: href(lang, '/ninni/?vista=stampe'), fuori: false },
  { testo: t('galleria.nav.carte'), url: href(lang, '/carte-e-cornici/'), fuori: false },
  { testo: 'PRISMA', url: PRISMA, fuori: true },
  { testo: t('galleria.nav.chi_siamo'), url: href(lang, '/chi-siamo/'), fuori: false },
  { testo: t('galleria.nav.contatti'), url: `${href(lang, '/chi-siamo/')}#contatti`, fuori: false },
];
---
<header class="hd wrap" data-hd>
  <div class="what" data-what>
    <button class="what__btn" type="button" aria-expanded="false" aria-controls="what-menu" data-what-apri>
      <span class="what__t" translate="no">What?</span>
    </button>
    <nav class="what__menu" id="what-menu" aria-label={t('galleria.nav.principale')} data-what-menu hidden>
      <ul class="what__ul">
        {voci.map((v) => (
          <li class="what__li">
            <a class="what__a" href={v.url} target={v.fuori ? '_blank' : undefined} rel={v.fuori ? 'noopener' : undefined}
              aria-current={!v.fuori && !v.url.includes('?') && !v.url.includes('#') && (pathname === v.url) ? 'page' : undefined}
              >{v.testo}{v.fuori && <span class="what__ext" aria-hidden="true">↗</span>}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="hd__nav">
    <Shop lang={lang} pathname={pathname} />
    <ContaCarrello lang={lang} />
    <Lingue lang={lang} pathname={pathname} ridotte={false} class="hd__lang" />
  </div>
</header>
<script>
  import '../lib/what-client';
</script>
