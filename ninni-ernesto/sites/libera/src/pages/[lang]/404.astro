---
// 404 semplice (components/NonTrovata.astro). Su Netlify public/_redirects manda qui /<lingua>/*.
import NonTrovata from '../../components/NonTrovata.astro';
import { localeStaticPaths, type Locale } from '@ne/core/i18n';
export const getStaticPaths = () => localeStaticPaths();
const lang = Astro.params.lang as Locale;
---
<NonTrovata lang={lang} />
