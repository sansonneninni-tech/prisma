---
/**
 * Home della versione libera: la parete (components/home/HomeLibera.astro). Con il footer, a differenza della
 * versione attuale. Lo sfondo prende la tinta della prima foto.
 */
import Base from '../../layouts/Base.astro';
import HomeLibera from '../../components/home/HomeLibera.astro';
import { localeStaticPaths, type Locale } from '@ne/core/i18n';
import { HOME } from '../../lib/home';
import { tintaOpera } from '../../lib/colori';
export const getStaticPaths = () => localeStaticPaths();
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} tinta={HOME.sequenza.opere[0] ? tintaOpera(HOME.sequenza.opere[0]) : undefined}>
  <HomeLibera lang={lang} />
</Base>
