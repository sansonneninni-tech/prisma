---
/**
 * C15 Lente: particolari e firma a schermo intero (DIREZIONE §6 P3, §8 A13). <dialog> modale: Esc, «Chiudi» e
 * Indietro chiudono (voce #lente nella storia, popstate intercettato prima del ClientRouter come in Casa); ← → fra i
 * particolari; clic/tocco o «Ingrandisci» = ×2,5 nel punto scelto, poi il mouse (o il dito) sposta il particolare.
 * Sul telefono resta anche il pizzico del browser. Le foto grandi (1500 px) si caricano all'apertura.
 * Comportamento in scheda-client.ts.
 */
import ArtworkPicture from '@ne/core/components/ArtworkPicture.astro';
import { getArtworkImage, type Artwork } from '@ne/core/catalog';
import { sep } from '@ne/core';
import { useT, type Locale } from '../../lib/i18n';
import type { Particolare } from '../../lib/scheda';

interface Props { art: Artwork; particolari: Particolare[]; lang: Locale }
const { art, particolari, lang } = Astro.props;
const t = useT(lang);
const tot = particolari.length;
---
{tot > 0 && (
  <dialog class="lente" data-lente aria-labelledby="lente-t" data-t-zoom={t('galleria.lente.zoom')} data-t-riduci={t('galleria.lente.riduci')}>
    <div class="lente__barra">
      <p class="lente__t" id="lente-t"><span>{art.title}</span> <span class="lente__n num" data-lente-n aria-live="polite"></span></p>
      <button class="lente__btn" type="button" data-lente-chiudi>{t('galleria.nav.chiudi')}</button>
    </div>
    <div class="lente__vista" data-lente-vista>
      {particolari.map((p, i) => (
        <figure class="lente__f" data-lente-f={i} hidden data-t-n={t('galleria.lente.contatore', { n: i + 1, tot })} data-nome={p.nome}>
          <div class="lente__zoom" data-lente-zoom>
            <ArtworkPicture image={getArtworkImage(art, p.id, { width: 1500, sizes: '100vw' })} lang={lang} alt={`${p.nome}${sep(lang).dp}${art.title}`} loading="lazy" class="lente__img" />
          </div>
          <figcaption class="vh">{p.nome}</figcaption>
        </figure>
      ))}
    </div>
    <div class="lente__comandi">
      {tot > 1 && <button class="lente__btn lente__btn--fr" type="button" data-lente-vai="-1" aria-label={t('galleria.lente.precedente')}><svg class="freccia" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M18 10H3M9 4l-6 6 6 6" /></svg></button>}
      <button class="lente__btn" type="button" data-lente-zoom-btn aria-pressed="false">{t('galleria.lente.zoom')}</button>
      {tot > 1 && <button class="lente__btn lente__btn--fr" type="button" data-lente-vai="1" aria-label={t('galleria.lente.successivo')}><svg class="freccia" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 10h15M11 4l6 6-6 6" /></svg></button>}
    </div>
  </dialog>
)}
