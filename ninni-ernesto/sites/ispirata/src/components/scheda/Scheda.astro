---
/**
 * P3 Scheda opera (DIREZIONE §6 P3, ref SSENSE 3 colonne + Artsy): «← Opere», titolo gigante, opera, acquisto, dati.
 * Una sola griglia con i figli nell'ordine del DOM titolo → opera → acquisto → dati (§10); le colonne le decide scheda.css:
 *   telefono: una colonna in quest'ordine, barra fissa in basso quando il bottone principale esce dallo schermo;
 *   768–1023 e telefono in orizzontale: opera | acquisto + dati;
 *   da 1024: dati | opera | acquisto (3/6/3); panoramiche (24, 25): opera a tutta larghezza, sotto dati | acquisto.
 * Audit del 28/10: si apre su Stampa (prima scheda), poi Edizione limitata; l'opera è l'anteprima della scelta
 * (cornice, passe-partout, carta) e si guarda da vicino con la lente; niente più riquadri dei particolari.
 * Acquisto: schede Stampa / Edizione limitata (C14) con markup proprio e la logica del core (toCartProduct,
 * toPrintCartProducts con gli 8 formati, addToCart in scheda-client.ts): l'AddToCart del core si aggancia una volta
 * sola e dopo un cambio pagina del ClientRouter resterebbe senza ascoltatori (stessa scelta di Casa).
 * `?v=stampa` sceglie la stampa prima del primo disegno (script inline subito dopo l'acquisto).
 */
import ArtworkPicture from '@ne/core/components/ArtworkPicture.astro';
import InstallmentsNote from '@ne/core/components/InstallmentsNote.astro';
import Torna from '../Torna.astro';
import Freccia from '../Freccia.astro';
import FiguraScala from './FiguraScala.astro';
import { fit } from '../../lib/fit';
import { href, useT, type Locale } from '../../lib/i18n';
import { hrefOpera } from '../../lib/opera-link';
import { tRate, type DatiScheda } from '../../lib/scheda';

interface Props { d: DatiScheda; lang: Locale }
const { d, lang } = Astro.props;
const t = useT(lang);
const { art } = d;
const f = fit(d.titolo);
const ratio = `${art.images.canvas?.width ?? 1}/${art.images.canvas?.height ?? 1}`;
const haOriginale = Boolean(d.originale);
const ed = d.edizione;
/** Due schede solo se c'è l'edizione limitata; altrimenti la sola parola «Stampa». */
const schede = Boolean(ed) && d.stampabile;
/** Si apre sempre sulla stampa quando c'è (audit 28/10); l'edizione limitata è la seconda scheda. */
const iniziale: 'o' | 's' = d.stampabile ? 's' : 'o';
const carrello = href(lang, '/carrello/');
const prodottiStampa = Object.fromEntries(d.stampe.map((s) => [s.chiave, s.product]));
const prezziStampa = Object.fromEntries(d.stampe.map((s) => [s.chiave, s.prezzo]));
const centsStampa = Object.fromEntries(d.stampe.map((s) => [s.chiave, s.cents]));
const prima = d.primaStampa;
// pezzo 7: l'opera viaggia nell'URL e la pagina d'arrivo mette un messaggio iniziale col suo titolo
const chiedi = `${href(lang, '/chi-siamo/')}?opera=${art.slug}#contatti`;
// figura in scala all'apertura: il formato di stampa scelto, senza cornice (poi la aggiorna scheda-client.ts)
const fPrima = prima ? d.anteprima.formati[prima.formato] : null;
const misureScala = fPrima ? { larghezzaCm: fPrima.w, altezzaCm: fPrima.h, profonditaCm: 0 } : d.ar.misure;
const sizes = d.panoramica ? '(min-width: 1920px) 1864px, 100vw' : '(min-width: 1024px) 50vw, (min-width: 768px) 58vw, 100vw';
---
<article
  class:list={['sk', 'wrap', d.panoramica && 'sk--pano']}
  data-scheda
  data-id={art.id}
  data-iniziale={iniziale}
  data-vista={iniziale}
  style={`--ar:${ratio};${f ? `--fit:${f};` : ''}`}
  aria-labelledby="sk-titolo"
>
  <Torna class="sk__torna" href={href(lang, `/${art.author}/`)}>{d.autore}</Torna>
  <div class="titolo sk__titolo">
    <h1 id="sk-titolo">{d.titolo}</h1>
    {/* panoramiche da 1024: l'acquisto sta sotto l'opera, quindi sotto il titolo una riga con misura e prezzo o
        «Venduta», sempre nella prima schermata (audit finale 1, #4) */}
    {d.panoramica && (
      <p class="sk__stato sep-riga">
        {d.misure && <span class="num">{d.misure}</span>}
        {d.venduta ? <span><span class="venduta">{t('etichette.venduta')}</span></span> : d.prezzo && <span class="num">{d.prezzo}</span>}
      </p>
    )}
  </div>

  <!-- anteprima della scelta: cornice, passe-partout e carta cambiano con le opzioni (lib/scheda-client.ts);
       clic sulla foto: una lente segue il mouse (o il dito) e fa vedere da vicino carta e cornice -->
  <figure class="sk__opera">
    <button class="sk__box" type="button" data-anteprima data-lente-apri aria-pressed="false" aria-label={t('galleria.scheda.lente')}
      data-cornice="none" data-carta={prima?.supporto ?? 'rag'} data-dati={JSON.stringify(d.anteprima)}>
      <span class="sk__cornice">
        <span class="sk__pp">
          <span class="sk__foto">
            <ArtworkPicture artwork={art} lang={lang} width={d.panoramica ? 1400 : 760} sizes={sizes} loading="eager" fetchpriority="high" />
            <span class="sk__carta" aria-hidden="true"></span>
          </span>
        </span>
      </span>
      <span class="sk__lente" data-lente hidden></span>
    </button>
    {(prima || ed) && <figcaption class="sk__dida" data-anteprima-dida>{prima ? `${d.anteprima.formati[prima.formato]?.et ?? ''} · ${d.anteprima.carte[prima.supporto] ?? ''} · ${d.anteprima.cornici.none}` : ''}</figcaption>}
  </figure>

  <section class="sk__acq acq" aria-label={t('galleria.scheda.acquisto')} data-acq>
    {schede ? (
      <div class="tabs acq__tabs" role="tablist" aria-label={t('galleria.scheda.schede')} data-acq-tabs>
        <button class="tabs__b" type="button" role="tab" id="sk-tab-s" aria-controls="sk-pan-s" aria-selected={iniziale === 's' ? 'true' : 'false'} tabindex={iniziale === 's' ? 0 : -1} data-v="s">{t('galleria.scheda.stampa')}</button>
        <button class="tabs__b" type="button" role="tab" id="sk-tab-o" aria-controls="sk-pan-o" aria-selected={iniziale === 'o' ? 'true' : 'false'} tabindex={iniziale === 'o' ? 0 : -1} data-v="o">{t('galleria.scheda.originale')}</button>
      </div>
    ) : (
      <p class="acq__solo">{t('galleria.scheda.stampa')}</p>
    )}

    <!-- Stampa: formato, carta, cornice -->
    {prima && (
      <div class="acq__pan" id="sk-pan-s" role={schede ? 'tabpanel' : undefined} aria-labelledby={schede ? 'sk-tab-s' : undefined} hidden={iniziale !== 's'} data-pan="s">
        <form class="acq__form" data-acq-form="s" data-products={JSON.stringify(prodottiStampa)} data-prices={JSON.stringify(prezziStampa)} data-cents={JSON.stringify(centsStampa)} data-max={d.maxStampe}
          data-t-n={t('galleria.scheda.nel_carrello_n')} data-t-max={t('galleria.scheda.max_stampe', { n: d.maxStampe })} data-t-piu={t('galleria.scheda.piu')}>
          <fieldset class="opz">
            <legend class="opz__l">{t('etichette.formato_stampa')}</legend>
            <div class="opz__g">
              {d.formati.map((fm) => (
                <label class="opz__v"><input type="radio" name="formato" value={fm.id} checked={fm.id === prima.formato} /><span>{fm.etichetta}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="opz">
            <legend class="opz__l">{t('galleria.scheda.carta')}</legend>
            <div class="opz__g opz__g--lista">
              {d.carte.map((c) => (
                <label class="opz__v opz__v--riga"><input type="radio" name="supporto" value={c.id} checked={c.id === prima.supporto} /><span><b>{c.nome}</b><small>{c.nota}</small></span><em class="opz__delta num" data-delta-carta={c.id}></em></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="opz">
            <legend class="opz__l">{t('galleria.scheda.cornice')}</legend>
            <div class="opz__g opz__g--lista">
              {d.cornici.map((c) => (
                <label class:list={['opz__v opz__v--riga', c.id === 'oak' && 'opz__v--scelta']}><input type="radio" name="cornice" value={c.id} checked={c.id === prima.cornice} /><span><b>{c.nome}</b><small>{c.nota}</small></span><em class="opz__delta num" data-delta-cornice={c.id}></em></label>
              ))}
            </div>
          </fieldset>
          <p class="acq__prezzo"><output class="num" data-acq-prezzo aria-live="polite">{prima.prezzo}</output><small>{d.notaPrezzoStampa}</small></p>
          <button class="btn btn--largo" type="submit" data-acq-btn>{t('bottoni.aggiungi_carrello')}</button>
          <p class="acq__nota" data-acq-nota hidden>
            <span data-acq-nota-t></span>
            <a class="lnk" href={carrello} data-carrello>{t('bottoni.vai_carrello')}</a>
          </p>
        </form>
      </div>
    )}

    <!-- Edizione limitata: numero, copie rimaste, prezzo a scaglioni (scarsità vera) -->
    {ed && (
      <div class="acq__pan" id="sk-pan-o" role="tabpanel" aria-labelledby="sk-tab-o" hidden={iniziale !== 'o'} data-pan="o">
        {haOriginale ? (
          <form class="acq__form" data-acq-form="o" data-products={JSON.stringify({ original: d.originale })}>
            <p class="ed__n">
              <span class="num">{t('galleria.edizione.numero', { n: ed.numero ?? 0, di: ed.totale })}</span>
              <span class="ed__rest">{t(ed.restano === 1 ? 'galleria.edizione.ultima' : 'galleria.edizione.restano', { n: ed.restano, di: ed.totale })}</span>
            </p>
            <p class="acq__prezzo"><span class="num" data-acq-prezzo>{d.prezzo}</span><small>{d.notaPrezzo}</small></p>
            {ed.prossimo && (
              <p class="ed__sale">{t(ed.aQuestoPrezzo === 1 ? 'galleria.edizione.sale_1' : 'galleria.edizione.sale_n', { n: ed.aQuestoPrezzo, prezzo: ed.prossimo })}</p>
            )}
            <ol class="ed__scala" aria-label={t('galleria.edizione.scaglioni')}>
              {ed.scalini.map((s) => (
                <li class:list={['ed__s', `ed__s--${s.stato}`]}>
                  <span class="ed__s-n num">{s.da === s.a ? `${s.da}` : `${s.da}–${s.a}`}</span>
                  <span class="ed__s-p num">{s.prezzo}</span>
                  {s.stato === 'venduto' && <span class="vh">{t('galleria.edizione.venduti')}</span>}
                </li>
              ))}
            </ol>
            <ul class="ed__inclusi">
              <li>{ed.misura} · {ed.carta}</li>
              <li>{ed.cornice} · <span class="num">{ed.misuraCornice}</span></li>
              <li>{t('galleria.edizione.firma', { autore: d.autore })}</li>
            </ul>
            <InstallmentsNote totalCents={art.priceCents} lang={lang} t={tRate(t)} class="acq__rate" />
            <button class="btn btn--largo" type="submit" data-acq-btn>{t('galleria.edizione.aggiungi', { n: ed.numero ?? 0 })}</button>
            <a class="btn btn--linea btn--largo" href={carrello} data-carrello data-acq-in hidden>{t('bottoni.aggiunta_carrello')}</a>
          </form>
        ) : (
          <div class="acq__vend">
            <p class="acq__venduto"><span class="venduta">{t('galleria.edizione.esaurita')}</span></p>
            <p class="ed__sale">{t('galleria.edizione.esaurita_nota', { n: ed.totale })}</p>
          </div>
        )}
      </div>
    )}

    <div class="acq__azioni">
      <button class="lnk acq__parete" type="button" data-parete-apri aria-haspopup="dialog">{t('galleria.scheda.parete')}<Freccia /></button>
      <a class="lnk" href={chiedi}>{t('bottoni.richiedi_info')}</a>
    </div>
    {haOriginale && <p class="acq__riga" data-tempi="o" hidden={iniziale !== 'o'}>{d.tempiOriginale}</p>}
    {prima && <p class="acq__riga" data-tempi="s" hidden={iniziale !== 's'}>{d.tempiStampa}</p>}
  </section>
  {schede && (
    <script is:inline data-astro-rerun>
      // ?v=stampa / ?v=originale prima del primo disegno (niente lampo della scheda sbagliata)
      (function () {
        var a = document.querySelector('[data-acq]'); if (!a) return;
        var v = new URLSearchParams(location.search).get('v');
        var w = v === 'stampa' ? 's' : v === 'originale' ? 'o' : null;
        if (!w) return;
        a.querySelectorAll('[role="tab"]').forEach(function (b) { var s = b.getAttribute('data-v') === w; b.setAttribute('aria-selected', String(s)); b.tabIndex = s ? 0 : -1; });
        a.querySelectorAll('[data-pan]').forEach(function (p) { p.hidden = p.getAttribute('data-pan') !== w; });
        a.querySelectorAll('[data-tempi]').forEach(function (p) { p.hidden = p.getAttribute('data-tempi') !== w; });
        var sk = a.closest('[data-scheda]'); if (sk) sk.setAttribute('data-vista', w);
      })();
    </script>
  )}

  <section class="sk__dati dati" aria-label={t('galleria.scheda.dati')}>
    {d.righe.length > 0 && (
      <dl class="dati__dl">
        {/* in vista Stampa: «Originale 100 × 80 cm» e niente riga Firma (la stampa non è firmata a mano) */}
        {d.righe.map((r) => (<div class="dati__r" data-riga={r.chiave}><dt>{r.chiave === 'misure' && schede ? <><span class="dati__solo-o">{r.etichetta}</span><span class="dati__solo-s">{t('galleria.scheda.originale')}</span></> : r.etichetta}</dt><dd class:list={[r.chiave === 'misure' && 'num']}>{r.valore}</dd></div>))}
      </dl>
    )}
    {d.descrizione && <p class="dati__p">{d.descrizione}</p>}
    <FiguraScala art={art} misure={misureScala} lang={lang} class="dati__scala" anteprima />
  </section>

  <!-- barra fissa in basso (sotto 1024): prezzo + azione principale quando il bottone vero non si vede -->
  <div class="barra" data-barra hidden>
    <span class="barra__p num" data-barra-prezzo></span>
    <button class="btn barra__b" type="button" data-barra-btn tabindex="-1">{t('bottoni.aggiungi_carrello')}</button>
  </div>
</article>

<nav class="vicine wrap" aria-label={t('galleria.scheda.vicine')}>
  <a class="vicine__a" href={hrefOpera(lang, d.precedente)} data-a3="indietro" rel="prev">
    <span class="vicine__dir"><Freccia dir="sinistra" />{t('galleria.scheda.precedente')}</span>
    <span class="vicine__t">{d.precedente.title}</span>
  </a>
  <a class="vicine__a vicine__a--succ" href={hrefOpera(lang, d.successiva)} data-a3="avanti" rel="next">
    <span class="vicine__dir">{t('galleria.scheda.successiva')}<Freccia /></span>
    <span class="vicine__t">{d.successiva.title}</span>
  </a>
</nav>
