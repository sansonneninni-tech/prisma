---
/**
 * /[lang]/ninni/ e /[lang]/ernesto/ — catalogo di un fotografo (ogni catalogo è separato e firmato da uno solo).
 * Titolo gigante col nome; sotto, schede Edizioni limitate · Stampe (`?vista=stampe`) e «Filtra».
 * Se il fotografo non ha ancora foto (Ernesto, per ora): il titolo, una riga e la lista d'attesa.
 */
import Base from '../../../layouts/Base.astro';
import TitoloGigante from '../../../components/opere/TitoloGigante.astro';
import Masonry from '../../../components/opere/Masonry.astro';
import PannelloFiltri from '../../../components/opere/PannelloFiltri.astro';
import Field from '@ne/core/components/Field.astro';
import { LOCALES, pickStrings } from '@ne/core/i18n';
import { useT, type Locale } from '../../../lib/i18n';
import { ALTEZZA_DIDA, cardOriginali, cardStampe } from '../../../lib/opere';
import motore from '../../../lib/opere-motore.js?raw';
import '../../../styles/opere.css';
import '../../../styles/core.css';
import '../../../styles/moduli.css';

export const getStaticPaths = () => LOCALES.flatMap((lang) => (['ninni', 'ernesto'] as const).map((autore) => ({ params: { lang, autore } })));
const lang = Astro.params.lang as Locale;
const autore = Astro.params.autore as 'ninni' | 'ernesto';
const t = useT(lang);

const originali = cardOriginali(lang, autore);
const stampe = cardStampe(lang, autore);
const vuoto = originali.length === 0 && stampe.length === 0;

const k = (c: string) => t(`galleria.opere.${c}`);
const testi = Object.fromEntries(
  ['filtra', 'filtra_n', 'azzera', 'togli', 'vuoto', 'vuoto_stampe',
    'mostra', 'mostra_1', 'mostra_0', 'mostra_stampe', 'mostra_stampe_1', 'mostra_stampe_0',
    'conteggio', 'conteggio_1', 'conteggio_0', 'conteggio_stampe', 'conteggio_stampe_1', 'conteggio_stampe_0',
  ].map((c) => [c, k(c)]),
);
const titolo = t(`galleria.nav.${autore}`);
const i18n = JSON.stringify({
  ...pickStrings(t, ['errori.email', 'core.checkout.errori_riepilogo', 'core.checkout.campi_da_compilare', 'galleria.ernesto.successo', 'galleria.isabella.invio']),
  'errori.obbligatorio': t('galleria.acquisto.obbligatorio'),
});
---
<Base lang={lang} title={titolo} description={t(`galleria.catalogo.${autore}_descrizione`)}>
  {vuoto ? (
    <section class="wrap op op--presto" aria-labelledby="op-h">
      <TitoloGigante testo={titolo} id="op-h" />
      <div class="presto">
        <p class="presto__lead">{t('galleria.ernesto.lead')}</p>
        <div class="presto__mod">
          <form class="ct presto__form" id="at" novalidate aria-label={t('galleria.ernesto.modulo')} data-modulo="attesa" data-i18n={i18n} data-lang={lang}>
            <div class="isa-error-summary" role="alert" tabindex="-1" data-error-summary hidden></div>
            <Field idPrefix="at" name="email" type="email" label={t('galleria.ernesto.campo')} required autocomplete="email" inputmode="email" />
            <button class="btn" type="submit">{t('galleria.ernesto.bottone')}</button>
            <p class="conv__demo">{t('galleria.isabella.demo')}</p>
          </form>
          <div class="conv__ok" role="status" tabindex="-1" data-modulo-ok hidden>
            <p class="conv__ok-t" data-modulo-ok-t></p>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="wrap op" data-opere data-vista="originali" data-dida={ALTEZZA_DIDA} data-testi={JSON.stringify(testi)} aria-labelledby="op-h">
      <TitoloGigante testo={titolo} id="op-h" />
      <div class="op-bar">
        <div class="tabs" role="tablist" aria-label={k('schede')}>
          <button class="tabs__b" type="button" role="tab" id="tab-originali" aria-controls="pan-originali" aria-selected="true" data-scheda data-valore="originali">{k('originali')}</button>
          <button class="tabs__b" type="button" role="tab" id="tab-stampe" aria-controls="pan-stampe" aria-selected="false" tabindex="-1" data-scheda data-valore="stampe">{k('stampe')}</button>
        </div>
        <button class="filtra" type="button" aria-haspopup="dialog" aria-controls="filtri" aria-expanded="false" data-filtri-apri><span data-filtri-n>{k('filtra')}</span></button>
      </div>
      <div class="attivi" data-chips hidden>
        <ul class="attivi__lista" data-chips-lista></ul>
        <span class="attivi__n" data-totale>{t('galleria.opere.conteggio', { n: originali.length })}</span>
      </div>
      <p class="vh" aria-live="polite" data-annuncio></p>

      <div class="op__pan" role="tabpanel" id="pan-originali" aria-labelledby="tab-originali" data-pannello="originali">
        <p class="op__nota">{t('galleria.catalogo.nota_edizioni')}</p>
        <Masonry cards={originali} lang={lang} eager={4} />
      </div>
      <div class="op__pan" role="tabpanel" id="pan-stampe" aria-labelledby="tab-stampe" data-pannello="stampe" hidden>
        <p class="op__nota">{t('galleria.catalogo.nota_stampe')}</p>
        <Masonry cards={stampe} lang={lang} />
      </div>
      <div class="vuoto" data-vuoto hidden>
        <p class="vuoto__p" data-vuoto-testo>{k('vuoto')}</p>
        <button class="lnk" type="button" data-azzera>{k('azzera_filtri')}</button>
      </div>

      <PannelloFiltri lang={lang} originali={originali} stampe={stampe} />
    </section>
    <script is:inline data-astro-rerun set:html={motore}></script>
  )}
</Base>

<script>
  import '../../../lib/opere-client';
  import '../../../lib/moduli-client';
</script>
